{
    "name": "fail-on-console",
    "version": "1.4.2",
    "description": "Fail Vitest or Jest tests when unexpected console logs, warnings or errors occur.",
    "keywords": [
        "jest",
        "vitest",
        "console",
        "testing"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/benquarmby/fail-on-console"
    },
    "license": "MIT",
    "main": "./index.js",
    "files": [
        "./CHANGELOG.md",
        "./index.d.ts"
    ],
    "scripts": {
        "commit:check": "commitlint --from-last-tag",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:jest": "jest",
        "test:vitest": "vitest run --coverage",
        "type:check": "tsc",
        "verify": "run-s commit:check format:check type:check test:vitest test:jest"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^21.2.2",
        "@vitest/coverage-v8": "4.1.11",
        "commitlint": "^21.2.2",
        "jest": "^30.4.2",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.6",
        "prettier-plugin-packagejson": "^3.0.2",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@11.22.0",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.19.0",
            "onFail": "download"
        }
    }
}
