{
    "name": "fail-on-console",
    "version": "1.5.1",
    "description": "Fail Vitest or Jest tests when unexpected console logs, warnings or errors occur.",
    "keywords": [
        "jest",
        "vitest",
        "console",
        "testing"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/benquarmby/fail-on-console"
    },
    "license": "MIT",
    "exports": {
        ".": "./lib/index.js",
        "./package.json": "./package.json"
    },
    "main": "./lib/index.js",
    "files": [
        "./CHANGELOG.md",
        "./lib/"
    ],
    "scripts": {
        "prebuild": "tsc --noEmit",
        "build": "tsc --project tsconfig.build.json",
        "clean": "del-cli ./lib",
        "commit:check": "commitlint --from-last-tag",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "run-s test:vitest test:jest",
        "test:jest": "jest",
        "test:vitest": "vitest run --coverage",
        "unused:check": "knip",
        "verify": "run-s commit:check format:check unused:check clean build test:vitest test:jest"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@types/node": "~24.19.2",
        "@vitest/coverage-v8": "^5.1.1",
        "del-cli": "^8.0.1",
        "jest": "^30.5.2",
        "knip": "^6.47.0",
        "npm-run-all2": "^9.1.0",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.1.0",
        "ts-jest": "^29.4.15",
        "typescript": "^6.0.3",
        "vitest": "^5.1.1"
    },
    "packageManager": "pnpm@12.18.0",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.22.3",
            "onFail": "download"
        }
    }
}
